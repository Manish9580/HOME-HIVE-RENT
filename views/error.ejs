
<% layout("/layouts/biolerplate") %>

<div class="row">
    <div class="alert alert-danger col-6 offset-3" role="alert">
        <% if (err && err.message) { %>
            <h4><%= err.message %></h4>
        <% } else { %>
            <h4>An unknown error occurred!</h4>
        <% } %>
    </div>
</div>
